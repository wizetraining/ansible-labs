# =============================================================================
# Nœud de contrôle — Ubuntu 22.04
#
# NOTE PÉDAGOGIQUE : Ansible n'est PAS installé ici. C'est l'objet du Lab 02.
# On ne fournit que les prérequis (client SSH, sshpass, pip, git).
# =============================================================================
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-client sshpass sudo \
        python3 python3-pip python3-venv \
        git jq tree vim less curl ca-certificates \
        iproute2 iputils-ping \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN echo 'root:root' | chpasswd \
    && useradd -m -s /bin/bash vagrant && echo 'vagrant:vagrant' | chpasswd \
    && printf 'vagrant ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/vagrant \
    && chmod 440 /etc/sudoers.d/vagrant

# Ne pas vérifier les host keys : évite les blocages interactifs pendant les labs
RUN mkdir -p /root/.ssh \
    && printf 'Host node*\n    StrictHostKeyChecking no\n    UserKnownHostsFile /dev/null\n' \
       > /root/.ssh/config \
    && chmod 600 /root/.ssh/config

# Alias de confort (identiques à la version Vagrant)
RUN printf "alias ap='ansible-playbook'\nalias ai='ansible-inventory'\nalias ll='ls -alF'\nexport ANSIBLE_NOCOWS=1\ncd /tp 2>/dev/null || true\n" \
    > /etc/profile.d/ansible-lab.sh

WORKDIR /tp
CMD ["sleep", "infinity"]
