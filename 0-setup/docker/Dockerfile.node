# =============================================================================
# Nœud cible — Ubuntu 22.04 + systemd + sshd
#
# systemd est indispensable : sans lui, les modules Ansible `service` et
# `systemd` échouent et les labs sur les handlers perdent tout leur sens.
# =============================================================================
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV container=docker

RUN apt-get update && apt-get install -y --no-install-recommends \
        systemd systemd-sysv \
        openssh-server sudo \
        python3 python3-apt \
        iproute2 iputils-ping curl ca-certificates tree vim less \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# --- Neutraliser les units systemd inutiles en conteneur -----------------------
RUN find /etc/systemd/system /lib/systemd/system \
        -path '*.wants/*' \
        \( -name '*udev*' -o -name '*getty*' -o -name '*journald*' \
           -o -name '*logind*' -o -name '*resolved*' -o -name '*networkd*' \) \
        -exec rm -f {} \; 2>/dev/null || true

# --- SSH ----------------------------------------------------------------------
RUN mkdir -p /var/run/sshd \
    && sed -i 's/^#\?PasswordAuthentication .*/PasswordAuthentication yes/' /etc/ssh/sshd_config \
    && sed -i 's/^#\?PermitRootLogin .*/PermitRootLogin yes/' /etc/ssh/sshd_config \
    && systemctl enable ssh

# --- Comptes ------------------------------------------------------------------
# root:root      -> dépannage
# admin:admin    -> compte de travail des labs, sudo sans mot de passe
# vagrant:vagrant-> alias du compte Vagrant pour que les labs soient identiques
RUN echo 'root:root' | chpasswd \
    && useradd -m -s /bin/bash admin && echo 'admin:admin' | chpasswd \
    && useradd -m -s /bin/bash vagrant && echo 'vagrant:vagrant' | chpasswd \
    && printf 'admin ALL=(ALL) NOPASSWD:ALL\n'   > /etc/sudoers.d/admin \
    && printf 'vagrant ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/vagrant \
    && chmod 440 /etc/sudoers.d/admin /etc/sudoers.d/vagrant

STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd"]
